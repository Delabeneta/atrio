generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Pessoa {
  id                   String              @id @default(cuid())
  nomeCompleto         String
  dataNascimento       DateTime
  telefone             String?
  endereco             String?
  bairro               String?
  cep                  String?
  comunidadeParticipa  String?
  comunidadeContribui  String?
  situacaoDizimista   String?             @default("DesejaSerDizimista")
  ehDizimista          Boolean             @default(true)
  estadoCivil          EstadoCivil         @default(Solteiro)
  batizado             Boolean             @default(false)
  desejaBatismo        Boolean             @default(false)
  catequista           Boolean             @default(false)
  desejaCatequese      Boolean             @default(false)
  confessaRegularmente Boolean             @default(false)
  frequenciaMissa      FrequenciaMissa     @default(Eventual)
  temEucaristia        Boolean             @default(false)
  temCrisma            Boolean             @default(false)
  temMatrimonio        Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  status               String?   @default("pendente") // ativo | inativo | pendente
  codigoDizimista      String?             @unique
  conjuge              Json?
  filhos               Json?
  movimentosPastorais  MovimentoPastoral[]
  observacoes          String?

  @@index([nomeCompleto])
  @@index([comunidadeParticipa])
  @@index([createdAt])
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      String   @default("member")
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([username])
}

enum EstadoCivil {
  Solteiro
  Casado
  Viuvo
  Divorciado
}

enum FrequenciaMissa {
  Diaria
  Semanal
  Eventual
}

enum MovimentoPastoral {
  PastoralFamiliar
  PastoralDizimista
  GrupoOracao
  Liturgia
  Catequese
  Coral
  Acolitos
  MinistroEucaristico
  LegiaoMaria
}