generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
}


enum Estadocivil{
    solteiro
    casado
    viuvo
    divorciado
}

enum FrequenciaMissa {
  Diaria
  Semanal
  Eventual
}

model Pessoa {
  id                    String         @id @default(cuid())
  nomeCompleto          String
  dataNascimento        DateTime
  email                 String?        @unique
  telefone              String?
  comunidadeParticipa   String?
  comunidadeContribui   String?
  contribuiDizimo       Boolean        @default(true)
  estadoCivil           EstadoCivil    @default(solteiro)
  
  // Campos JSON (flexíveis para dados complexos)
  conjuge               Json?          // { nome, dataNascimento, dizimista }
  filhos                Json?          // [{ nome, dataNascimento }]
  sacramentos           Json?          // { eucaristia, crisma, matrimonio }
  
  // Campos booleanos de vida espiritual
  batizado              Boolean        @default(false)
  desejaBatismo         Boolean        @default(false)
  catequista            Boolean        @default(false)
  desejaCatequese       Boolean        @default(false)
  confessaRegularmente  Boolean        @default(false)
  
  // Campos de prática religiosa
  frequenciaMissa       FrequenciaMissa @default(Eventual)
  movimentosPastorais   String[]       // Array de strings
  
  // Datas de controle
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  
  // Índices para buscas rápidas
  @@index([nomeCompleto])
  @@index([email])
  @@index([comunidadeParticipa])
  @@index([createdAt])
}

// Model para Usuários (Autenticação)
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // Será armazenado com hash (bcrypt)
  role      String   @default("member") // admin ou member
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([username])
}

// Model para Logs (opcional - auditoria)
model Log {
  id        String   @id @default(cuid())
  userId    String?
  action    String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT
  entity    String?  // PESSOA, USER
  entityId  String?
  details   Json?    // Mudanças feitas
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  
  @@index([createdAt])
  @@index([userId])
}

// Model para Configurações do Sistema
model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  description String?
  updatedAt DateTime @updatedAt
}

// Model para Backup (registro)
model Backup {
  id        String   @id @default(cuid())
  filename  String
  size      Int      // Tamanho em bytes
  status    String   // SUCCESS, FAILED, PENDING
  error     String?
  createdAt DateTime @default(now())
  
  @@index([createdAt])
}