generator client {
  provider = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Pessoa {
  id                   String              @id @default(cuid())
  nomeCompleto         String
  dataNascimento       DateTime
  email                String?             @unique
  telefone             String?
  bairro               String?
  cidade               String?
  cep                  String?
  comunidadeParticipa  String?
  comunidadeContribui  String?
  ehDizimista          Boolean             @default(false)
  estadoCivil          EstadoCivil         @default(Solteiro)
  batizado             Boolean             @default(false)
  desejaBatismo        Boolean             @default(false)
  catequista           Boolean             @default(false)
  desejaCatequese      Boolean             @default(false)
  confessaRegularmente Boolean             @default(false)
  frequenciaMissa      FrequenciaMissa     @default(Eventual)
  temEucaristia        Boolean             @default(false)
  temCrisma            Boolean             @default(false)
  temMatrimonio        Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  ativo                Boolean             @default(true)
  codigoDizimista      String?             @unique
  conjuge              Json?
  filhos               Json?
  movimentosPastorais  MovimentoPastoral[]
  observacoes          String?

  @@index([nomeCompleto])
  @@index([comunidadeParticipa])
  @@index([createdAt])
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      String   @default("member")
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([username])
}

model Log {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  details   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

model Backup {
  id        String   @id @default(cuid())
  filename  String
  size      Int
  status    String
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

enum EstadoCivil {
  Solteiro
  Casado
  Viuvo
  Divorciado
}

enum FrequenciaMissa {
  Diaria
  Semanal
  Eventual
}

enum MovimentoPastoral {
  PastoralFamiliar
  PastoralDizimista
  GrupoOracao
  Liturgia
  Catequese
  Coral
  Acolitos
  MinistroEucaristico
  LegiaoMaria
}
